{
  "name": "@pipelex/sdk",
  "version": "0.5.1",
  "description": "TypeScript SDK for the Pipelex hosted API — execute methods, manage runs, and call the product surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pipelex/pipelex-sdk-js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:hook": "node scripts/build-hook.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\"",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:test && npm run build && npm run depcruise",
    "prepare": "tsc"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@pipelex/tools-wasm": "^0.1.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.8.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "mthds": "^0.20.0"
  }
}
